# Firebase web app config (Firebase console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=legaleval.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=legaleval
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=legaleval.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# API backend
NEXT_PUBLIC_LEGAL_EVAL_API_URL=http://127.0.0.1:8787

# Optional: only needed for /api/auth/session in local dev without ADC
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Public demo run (optional)
NEXT_PUBLIC_DEMO_SHARE_TOKEN=le_demo_public_v1
